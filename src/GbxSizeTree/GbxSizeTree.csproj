<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>gbx-size-tree</AssemblyName>
    <RootNamespace>GbxSizeTree.Cli</RootNamespace>
    <ApplicationIcon>../../assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publish-only: keeps ordinary builds framework-dependent so the test project can reference this exe. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ~16.9 MB vs ~41 MB untrimmed, zero trim warnings; release smokes must compare
         report output and optimized-file hashes against expectations before shipping.
         Override with -p:PublishTrimmed=false if a trim regression is suspected. -->
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GbxSizeTree.Core/GbxSizeTree.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="[2.1.7]" />
    <PackageReference Include="SixLabors.Fonts" Version="[2.1.3]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Fonts/*.ttf" />
    <EmbeddedResource Include="Resources/Licenses/AtkinsonHyperlegibleNext-OFL.txt" />
    <EmbeddedResource Include="Resources/Licenses/JetBrainsMono-OFL.txt" />
  </ItemGroup>

</Project>
